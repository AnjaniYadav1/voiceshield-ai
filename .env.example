# Copy this file to .env in the backend/ directory and adjust as needed.

# "auto" tries real ML pipeline, falls back to demo automatically.
# "real" forces the real feature-based pipeline (fails loudly if unavailable).
# "demo" forces deterministic simulated results (always works, zero ML deps).
VOICESHIELD_MODE=auto

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
